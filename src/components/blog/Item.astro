---
interface Props { term: string }
const { term } = Astro.props;
---
<div class="item">
  <dt class="label">{term}</dt>
  <dd><slot /></dd>
</div>

<style>
  .item { display: grid; grid-template-columns: 150px 1fr; gap: var(--space-4); padding: 12px 0; align-items: baseline; }
  .item + .item { border-top: 1px solid var(--line); }
  dt { color: var(--ink); }
  dd { margin: 0; font: 400 16px/26px var(--sans); }
  @media (max-width: 600px) { .item { grid-template-columns: 1fr; gap: 2px; } }
</style>
