---
// Section 2.3: one fact before and after it earns a place in MEMORY.md. An illustration:
// OpenClaw publishes no sample entry.
import Figure from './Figure.astro';
import Glyph from './Glyph.astro';
interface Props { n?: number }
const { n } = Astro.props;
---
<Figure n={n} caption="One fact before and after it earns a place in MEMORY.md. An illustration." strip="76px">
  <div class="flow">
    <div class="card note">
      <p class="label">Daily note</p>
      <p class="file mono">memory/2026-11-21.md</p>
      <p class="line mono"><span class="hl">- Sam uses pnpm instead of npm.</span></p>
    </div>

    <div class="mid">
      <svg class="arr" viewBox="0 0 24 12" aria-hidden="true"><path d="M1 6h18" /><path d="M14 1.5 20 6l-6 4.5" /></svg>
      <div class="part chip" tabindex="0">
        <Glyph name="moon" size={28} />
        <span class="t">the night job</span>
        <span class="s mono">future blog</span>
        <span class="say"><span class="label">The night job</span>It reads the notes and decides which facts earn a place. We will cover how in a future blog.</span>
      </div>
      <svg class="arr" viewBox="0 0 24 12" aria-hidden="true"><path d="M1 6h18" /><path d="M14 1.5 20 6l-6 4.5" /></svg>
    </div>

    <div class="part card mem" tabindex="0">
      <p class="label">Long-term</p>
      <p class="file mono">MEMORY.md</p>
      <p class="line mono"><span class="hl">- Sam uses pnpm instead of npm.</span></p>
      <p class="src mono">Source: memory/2026-11-21.md#L2-L4</p>
      <span class="say"><span class="label">An illustration</span>OpenClaw publishes no sample entry, so the real format of the line and its source may differ.</span>
    </div>
  </div>
</Figure>

<style>
  .flow { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.15fr); gap: var(--space-3); align-items: center; }
  .card { display: grid; gap: 4px; padding: var(--space-4); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface-raised); }
  .note { border-color: color-mix(in srgb, var(--running) 35%, var(--line)); }
  .mem { border-color: color-mix(in srgb, var(--signal) 40%, var(--line)); }
  .note .label { color: var(--running); }
  .mem .label { color: var(--signal); }
  .file { font-size: 12px; line-height: 18px; color: var(--ink-muted); }
  .line { font-size: 13px; line-height: 20px; margin-top: 4px; }
  .note .hl { background: var(--running-soft); }
  .mem .hl { background: var(--signal-soft); }
  .hl { padding: 1px 4px; margin: 0 -4px; border-radius: var(--radius-sm); overflow-wrap: anywhere; }
  .src { font-size: 11px; line-height: 16px; color: var(--ink-faint); overflow-wrap: anywhere; }

  .mid { display: flex; align-items: center; gap: 4px; }
  .arr { width: 22px; height: 11px; flex: none; fill: none; stroke: var(--ink-muted); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 3 4; }
  .arr path:last-child { stroke-dasharray: none; }
  .chip {
    display: grid; justify-items: center; gap: 1px; padding: 8px 10px; text-align: center;
    background: var(--surface-raised); border: 1px dashed var(--line-strong); border-radius: var(--radius-md);
  }
  .t { font: 600 13px/18px var(--sans); }
  .s { font-size: 11px; line-height: 14px; color: var(--ink-muted); }

  @media (max-width: 640px) {
    .flow { grid-template-columns: 1fr; }
    .mid { justify-content: center; }
    .arr { transform: rotate(90deg); }
  }
</style>
