---
export type Status = 'shipped' | 'running' | 'mvp' | 'broken' | 'archived';
interface Props { status: Status }
const labels: Record<Status, string> = { shipped: 'Shipped', running: 'Running', mvp: 'MVP', broken: 'Broken', archived: 'Archived' };
const { status } = Astro.props;
---
<span class={`pill pill-${status}`}><span class="dot" aria-hidden="true"></span>{labels[status]}</span>
<style>
  .pill { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 12px; line-height: 18px; font-weight: 500; padding: 2px 10px; border-radius: var(--radius-pill); white-space: nowrap; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .pill-shipped { color: var(--signal); background: var(--signal-soft); }
  .pill-running, .pill-mvp { color: var(--running); background: var(--running-soft); }
  .pill-broken { color: var(--regress); background: var(--regress-soft); }
  .pill-archived { color: var(--ink-muted); background: var(--surface-sunken); }
</style>
