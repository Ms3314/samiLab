---
// The only JavaScript on the site. Cycles auto → white → black.
---
<button class="theme-toggle" type="button" data-theme-toggle aria-label="Theme: auto. Switch theme">
  <svg class="i i-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"/></svg>
  <svg class="i i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="i i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg>
  <span class="t meta" data-theme-label>auto</span>
</button>
<script is:inline>
  (() => {
    const order = ['auto', 'light', 'dark'];
    const names = { auto: 'auto', light: 'white', dark: 'black' };
    const root = document.documentElement;
    const get = () => root.dataset.theme || 'auto';
    const paint = (btn) => {
      const t = get();
      btn.dataset.state = t;
      btn.setAttribute('aria-label', 'Theme: ' + names[t] + '. Switch theme');
      const l = btn.querySelector('[data-theme-label]');
      if (l) l.textContent = names[t];
    };
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      paint(btn);
      btn.addEventListener('click', () => {
        const next = order[(order.indexOf(get()) + 1) % order.length];
        if (next === 'auto') delete root.dataset.theme; else root.dataset.theme = next;
        try { next === 'auto' ? localStorage.removeItem('theme') : localStorage.setItem('theme', next); } catch (e) {}
        paint(btn);
      });
    });
  })();
</script>
<style>
  .theme-toggle { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 10px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); background: transparent; color: var(--ink-muted); cursor: pointer; transition: color 150ms, border-color 150ms; }
  .theme-toggle:hover { color: var(--ink); border-color: var(--ink); }
  .i { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; display: none; }
  .theme-toggle:not([data-state]) .i-auto, [data-state='auto'] .i-auto, [data-state='light'] .i-light, [data-state='dark'] .i-dark { display: block; }
  .t { color: inherit; min-width: 4.2ch; text-align: left; }
  @media (max-width: 479px) { .t { display: none; } }
</style>
