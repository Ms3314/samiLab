---
import Parser from 'rss-parser';

const parser = new Parser();
let blogPosts: any[] = [];
let githubProjects: any[] = [];

// Fetch Medium blog posts
try {
    const feed = await parser.parseURL('https://medium.com/feed/@hsamiuddin405');
    blogPosts = feed.items.slice(0, 3).map((item: any) => {
        // Extract date and format it
        const date = item.pubDate ? new Date(item.pubDate) : null;
        const formattedDate = date ? date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : '';
        
        // Extract description (remove HTML tags)
        const description = item.contentSnippet || item.content 
            ? (item.contentSnippet || item.content).replace(/<[^>]*>/g, '').substring(0, 100) + '...'
            : 'Read more...';
        
        return {
            title: item.title || 'Untitled',
            link: item.link || '#',
            description: description,
            date: formattedDate
        };
    });
} catch (error) {
    console.error('Error fetching Medium feed:', error);
    blogPosts = [];
}

// Fetch GitHub repositories
try {
    const response = await fetch('https://api.github.com/users/Ms3314/repos?sort=updated&per_page=100', {
        headers: {
            'Accept': 'application/vnd.github.v3+json',
            'User-Agent': 'Portfolio'
        }
    });
    
    if (response.ok) {
        const repos = await response.json();
        // Get top 3 repositories by stars (typically pinned ones)
        githubProjects = repos
            .filter((repo: any) => !repo.fork && repo.description) // Filter out forks and repos without descriptions
            .sort((a: any, b: any) => b.stargazers_count - a.stargazers_count) // Sort by stars
            .slice(0, 3)
            .map((repo: any) => {
                // Get language or default tech stack
                const languages = repo.language || 'Code';
                const topics = repo.topics || [];
                
                return {
                    name: repo.name,
                    description: repo.description || 'No description available',
                    url: repo.html_url,
                    language: languages,
                    stars: repo.stargazers_count,
                    topics: topics.slice(0, 4) // Limit to 4 topics
                };
            });
    }
} catch (error) {
    console.error('Error fetching GitHub repositories:', error);
    githubProjects = [];
}
