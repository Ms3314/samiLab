---
import { postUrl, isoDate, minutesRead, type Post } from '../lib/posts';
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ol class="posts">
  {posts.map((p) => (
    <li>
      <a href={postUrl(p)} class="row">
        <time class="meta" datetime={p.data.date.toISOString()}>{isoDate(p.data.date)}</time>
        <span class="body">
          <span class="t">{p.data.title}{p.data.draft && <span class="draft label"> draft</span>}</span>
          {p.data.description && <span class="d">{p.data.description}</span>}
        </span>
        <span class="meta rt">{minutesRead(p)} min read</span>
      </a>
    </li>
  ))}
</ol>
<style>
  .posts { list-style: none; }
  li + li { border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 104px 1fr auto; gap: var(--space-2) var(--space-6); padding: var(--space-6) 0; color: var(--ink); align-items: baseline; }
  .row:hover { color: var(--ink); }
  .body { display: grid; gap: var(--space-2); }
  .t { font-family: var(--serif); font-size: 22px; line-height: 28px; font-weight: 500; letter-spacing: -0.01em; color: var(--link); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: color 150ms, text-decoration-color 150ms; }
  .row:hover .t { color: var(--link-strong); text-decoration-color: currentColor; }
  .row:focus-visible .t { text-decoration-color: currentColor; }
  .d { color: var(--ink-muted); font-size: 15px; line-height: 22px; max-width: 60ch; }
  .rt { color: var(--ink-faint); white-space: nowrap; }
  .draft { color: var(--running); }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr auto; }
    .body { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
