<a href="/" class="wordmark" aria-label="samilab, home">samilab<span class="cursor" aria-hidden="true"></span></a>
<style>
  .wordmark { font-family: var(--mono); font-weight: 500; font-size: 15px; color: var(--ink); letter-spacing: -0.01em; display: inline-flex; align-items: center; }
  .wordmark:hover { color: var(--ink); }
  .cursor { display: inline-block; width: 8px; height: 15px; margin-left: 3px; background: var(--signal); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
</style>
