---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container row">
    <p class="meta">© {year} {SITE.author} · {SITE.location}</p>
    <ul class="links">
      <li><a href={SITE.socials.github} rel="me noopener">GitHub</a></li>
      <li><a href={SITE.socials.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href={SITE.socials.x} rel="me noopener">X</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--space-24); border-top: 1px solid var(--line); padding: var(--space-8) 0 var(--space-12); }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; justify-content: space-between; }
  .links { display: flex; gap: var(--space-4); list-style: none; font-size: 15px; }
</style>
