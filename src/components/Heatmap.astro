---
// A static SVG activity grid (53 weeks × 7 days) in the heat-0…heat-4 ramp.
import type { Activity } from '../lib/activity';
interface Props { title: string; href: string; data: Activity; unit: string }
const { title, href, data, unit } = Astro.props;

const max = Math.max(1, ...data.days.map((d) => d.count));
const level = (n: number) => (n === 0 ? 0 : Math.min(4, Math.ceil((n / max) * 4)));
const cell = 10, gap = 3, step = cell + gap;
const weeks = Math.ceil(data.days.length / 7);
const w = weeks * step - gap, h = 7 * step - gap;
const monthLabels: { x: number; t: string }[] = [];
let lastMonth = -1;
data.days.forEach((d, i) => {
  const m = new Date(d.date).getUTCMonth();
  if (i % 7 === 0 && m !== lastMonth) {
    lastMonth = m;
    monthLabels.push({ x: Math.floor(i / 7) * step, t: new Date(d.date).toLocaleString('en', { month: 'short', timeZone: 'UTC' }) });
  }
});
if (monthLabels.length > 1 && monthLabels[1].x - monthLabels[0].x < 3 * step) monthLabels.shift();
---
<figure class="heat card">
  <figcaption>
    <a href={href} rel="noopener" class="h3 name">{title}</a>
    <span class="meta"><span class="n">{data.total.toLocaleString('en')}</span> {unit} · <span class="n">{data.activeDays}</span> active days · last 12 months</span>
  </figcaption>
  <div class="scroll">
    <svg viewBox={`0 -16 ${w} ${h + 16}`} style={`--w:${w}px`} role="img" aria-label={`${title}: ${data.total} ${unit} in the last 12 months`}>
      {monthLabels.map((m) => <text x={m.x} y="-5" class="mlabel">{m.t}</text>)}
      {data.days.map((d, i) => (
        <rect x={Math.floor(i / 7) * step} y={(i % 7) * step} width={cell} height={cell} rx="2" class={`l${level(d.count)}`}>
          <title>{d.date}: {d.count}</title>
        </rect>
      ))}
    </svg>
  </div>
  {data.extra && (
    <dl class="extra">
      {data.extra.map((e) => (<div><dt class="label">{e.label}</dt><dd class="mono">{e.value}</dd></div>))}
    </dl>
  )}
</figure>
<style>
  .heat { margin: 0; display: grid; gap: var(--space-4); }
  figcaption { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); }
  .name { color: var(--ink); font-weight: 600; }
  .name:hover { color: var(--link); }
  .n { color: var(--ink); }
  .scroll { overflow-x: auto; scrollbar-width: thin; }
  svg { max-width: none; width: 100%; min-width: var(--w); }
  .mlabel { font-family: var(--mono); font-size: 10px; fill: var(--ink-muted); }
  rect.l0 { fill: var(--heat-0); } rect.l1 { fill: var(--heat-1); } rect.l2 { fill: var(--heat-2); } rect.l3 { fill: var(--heat-3); } rect.l4 { fill: var(--heat-4); }
  .extra { display: flex; flex-wrap: wrap; gap: var(--space-6); margin: 0; }
  .extra div { display: grid; gap: 2px; }
  .extra dd { margin: 0; font-size: 18px; line-height: 24px; font-weight: 500; }
</style>
