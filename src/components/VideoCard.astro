---
import type { Video } from '../data/videos';
import VideoThumb from './VideoThumb.astro';
interface Props { video: Video }
const { video: v } = Astro.props;
---
<a class="video" href={`https://www.youtube.com/watch?v=${v.id}`} rel="noopener">
  <VideoThumb art={v.art} tone={v.tone} tag={v.series} id={v.id} />
  <span class="t">{v.title}</span>
</a>
<style>
  .video { display: grid; gap: var(--space-2); align-content: start; color: var(--ink); }
  .video:hover { color: var(--ink); }
  .t { margin-top: var(--space-1); font-size: 16px; line-height: 23px; font-weight: 500; transition: color 150ms; }
  .video:hover .t { color: var(--link); }
</style>
