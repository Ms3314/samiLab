---
import type { Video } from '../data/videos';
interface Props { video: Video }
const { video: v } = Astro.props;
---
<a class="video" href={`https://www.youtube.com/watch?v=${v.id}`} rel="noopener">
  <span class="thumb">
    <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span>
  </span>
  <span class="label">{v.series}</span>
  <span class="t">{v.title}</span>
</a>
<style>
  .video { display: grid; gap: var(--space-2); align-content: start; color: var(--ink); }
  .video:hover { color: var(--ink); }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-md); border: 1px solid var(--line); background: var(--surface-sunken); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 300ms; }
  .video:hover img { transform: scale(1.03); }
  .play { position: absolute; left: 12px; bottom: 12px; width: 36px; height: 36px; border-radius: 50%; background: var(--bg); display: grid; place-items: center; border: 1px solid var(--line); }
  .play svg { width: 16px; height: 16px; fill: var(--ink); margin-left: 2px; }
  .label { margin-top: var(--space-1); }
  .t { font-size: 16px; line-height: 23px; font-weight: 500; transition: color 150ms; }
  .video:hover .t { color: var(--link); }
</style>
