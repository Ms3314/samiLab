---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { getPosts, ogUrl, isoDate, minutesRead, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const minutes = minutesRead(post);
---
<Base title={d.title} description={d.description} image={ogUrl(post)} type="article" published={d.date} modified={d.updated} tags={d.tags}>
  <article class="container post">
    <header class="post-head">
      <p class="meta">
        <time datetime={d.date.toISOString()}>{isoDate(d.date)}</time>
        <span aria-hidden="true"> · </span>{minutes} min read
        {d.updated && <><span aria-hidden="true"> · </span>updated <time datetime={d.updated.toISOString()}>{isoDate(d.updated)}</time></>}
        {d.draft && <span class="draft"> · draft</span>}
      </p>
      <h1 class="title">{d.title}</h1>
      {d.description && <p class="lede">{d.description}</p>}
      {d.tags.length > 0 && <ul class="chips">{d.tags.map((t) => <li class="chip">{t}</li>)}</ul>}
    </header>

    <div class="layout">
      <aside class="rail"><div class="sticky"><Toc headings={headings} /></div></aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    {(older || newer) && <nav class="pager" aria-label="More posts">
      {older ? <a href={`/blog/${older.id}/`}><span class="label">Older</span><span class="t">{older.data.title}</span></a> : <span />}
      {newer && <a class="r" href={`/blog/${newer.id}/`}><span class="label">Newer</span><span class="t">{newer.data.title}</span></a>}
    </nav>}
  </article>
</Base>

<style>
  .post-head { max-width: var(--measure); margin: 0 auto; display: grid; gap: var(--space-4); padding: var(--space-16) 0 var(--space-12); }
  .draft { color: var(--running); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr); }
  .rail { display: none; }
  .prose { max-width: var(--measure); margin: 0 auto; width: 100%; }
  @media (min-width: 1100px) {
    .post-head { margin-left: calc(var(--rail) + var(--space-12)); }
    .layout { grid-template-columns: var(--rail) minmax(0, var(--measure)); gap: var(--space-12); }
    .rail { display: block; }
    .prose { margin: 0; }
  }
  .sticky { position: sticky; top: var(--space-8); max-height: calc(100vh - 64px); overflow: auto; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); max-width: var(--measure); margin: var(--space-16) auto 0; padding-top: var(--space-8); border-top: 1px solid var(--line); }
  @media (min-width: 1100px) { .pager { margin-left: calc(var(--rail) + var(--space-12)); } }
  .pager a { display: grid; gap: 4px; color: var(--ink); }
  .pager .r { text-align: right; }
  .pager .t { font-family: var(--serif); font-size: 19px; line-height: 26px; }
  .pager a:hover .t { color: var(--link); }
</style>
