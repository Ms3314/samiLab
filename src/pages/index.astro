---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import portrait from '../assets/sami.jpg';
import { SITE } from '../data/site';
import { featuredProjects, projects, experience } from '../data/projects';
import { videos, videoGroups } from '../data/videos';
import VideoCard from '../components/VideoCard.astro';
import { getPosts } from '../lib/posts';
import { getMediumPosts } from '../lib/medium';

const [posts, medium] = await Promise.all([getPosts(), getMediumPosts()]);
const fmtMonth = (d: Date) => d.toISOString().slice(0, 7);
---
<Base>
  <div class="container">
    <section class="hero">
      <div class="id">
        <Image src={portrait} alt="Mohammed Samiuddin" width={112} height={112} densities={[1, 2]} loading="eager" fetchpriority="high" class="avatar" />
        <div>
          <h1 class="name">Mohammed Samiuddin</h1>
          <p class="role">Applied AI Engineer <span aria-hidden="true">·</span> Hyderabad</p>
        </div>
      </div>
      <p class="bio">I work on evals, voice agents, RAG and MCP servers.</p>
      <ul class="icons" aria-label="Elsewhere">
        <li><a href={SITE.socials.x} rel="me noopener" aria-label="X" title="X"><svg viewBox="0 0 24 24"><path d="M4 4l16 16M20 4L4 20" /></svg></a></li>
        <li><a href={SITE.socials.linkedin} rel="me noopener" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></svg></a></li>
        <li><a href={SITE.socials.github} rel="me noopener" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24"><path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg></a></li>
        <li><a href={SITE.socials.medium} rel="me noopener" aria-label="Medium" title="Medium"><svg viewBox="0 0 24 24"><circle cx="7" cy="12" r="4.5" /><ellipse cx="15.5" cy="12" rx="2" ry="4.5" /><path d="M21 7.5v9" /></svg></a></li>
        <li><a href="/rss.xml" aria-label="RSS feed" title="RSS"><svg viewBox="0 0 24 24"><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" /><circle cx="6" cy="18" r="1" /></svg></a></li>
      </ul>
    </section>

    <section class="section" id="work">
      <div class="section-head"><h2 class="label">Selected projects</h2><a href="/projects" class="meta link">All {projects.length} projects →</a></div>
      <div class="grid-3">
        {featuredProjects.map((p) => <ProjectCard project={p} variant="home" />)}
      </div>
      <p class="more"><a class="btn btn-outline" href="/projects">See all {projects.length} projects</a></p>
    </section>

    {posts.length > 0 && (
      <section class="section" id="writing">
        <div class="section-head"><h2 class="label">Writing</h2><a href="/blog" class="meta link">All posts →</a></div>
        <PostList posts={posts.slice(0, 4)} />
      </section>
    )}

    <section class="section" id="experience">
      <div class="section-head"><h2 class="label">Experience</h2></div>
      <ol class="jobs">
        {experience.map((j) => (
          <li class="job">
            <div class="when meta">{j.period}</div>
            <div>
              <h3 class="h3">{j.role}<span class="at"> · {j.company}</span></h3>
              <ul class="points">{j.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" id="talks">
      <div class="section-head"><h2 class="label">Teaching and talks</h2><span class="meta">{videos.length} videos on YouTube</span></div>
      <div class="vgroups">
        {videoGroups.map((g) => (
          <div class="vgroup">
            <h3 class="h3">{g.name}</h3>
            <div class="grid-3 videos">{g.videos.map((v) => <VideoCard video={v} />)}</div>
          </div>
        ))}
      </div>
    </section>

    {medium.length > 0 && (
      <section class="section" id="elsewhere">
        <div class="section-head"><h2 class="label">Elsewhere · Medium</h2><a href={SITE.socials.medium} rel="noopener" class="meta link">Medium profile →</a></div>
        <ul class="elsewhere">
          {medium.map((m) => (
            <li>{m.date && <span class="meta">{fmtMonth(m.date)}</span>}<a href={m.link} rel="noopener">{m.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .hero { display: grid; gap: var(--space-6); padding-top: var(--space-16); }
  @media (min-width: 880px) { .hero { padding-top: var(--space-24); } }
  .id { display: flex; align-items: center; gap: var(--space-6); }
  .hero :global(.avatar) { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; border: 1px solid var(--line); flex: none; }
  @media (min-width: 720px) { .hero :global(.avatar) { width: 112px; height: 112px; } }
  .name { font-family: var(--serif); font-weight: 400; font-size: clamp(32px, 5vw, 44px); line-height: 1.1; letter-spacing: -0.015em; }
  .role { margin-top: 6px; font-size: 17px; line-height: 26px; color: var(--ink-muted); }
  .bio { font-size: 17px; line-height: 28px; color: var(--ink); }
  .icons { display: flex; gap: var(--space-2); list-style: none; margin-left: -8px; }
  .icons a { display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--radius-md); color: var(--ink-muted); }
  .icons a:hover { color: var(--link); background: var(--link-soft); }
  .icons svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .link { color: var(--link); }
  .link:hover { color: var(--link-strong); }

  .grid-2 { display: grid; gap: var(--space-6); }
  .more { margin-top: var(--space-8); }
  .grid-3 { display: grid; gap: var(--space-6); }
  .vgroups { display: grid; gap: var(--space-12); }
  .vgroup { display: grid; gap: var(--space-4); }
  @media (min-width: 720px) { .grid-3 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .grid-3 { grid-template-columns: 1fr 1fr 1fr; } }
  @media (min-width: 760px) { .grid-2 { grid-template-columns: 1fr 1fr; } }

  .jobs { list-style: none; display: grid; gap: var(--space-8); }
  .job { display: grid; gap: var(--space-2) var(--space-8); }
  @media (min-width: 760px) { .job { grid-template-columns: 180px 1fr; } }
  .when { padding-top: 4px; }
  .at { color: var(--ink-muted); font-weight: 400; }
  .points { margin-top: var(--space-3); padding-left: 18px; display: grid; gap: 6px; color: var(--ink-muted); font-size: 15px; line-height: 24px; max-width: var(--measure); }



  .elsewhere { list-style: none; display: grid; }
  .elsewhere li { display: grid; grid-template-columns: 104px 1fr; gap: var(--space-6); padding: var(--space-3) 0; border-top: 1px solid var(--line); align-items: baseline; }
  .elsewhere li:first-child { border-top: 0; }
  @media (max-width: 560px) { .elsewhere li { grid-template-columns: 1fr; gap: 2px; } }
</style>
