---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <div class="container nf">
    <p class="label">404</p>
    <h1 class="title">This page didn’t make it out of the lab.</h1>
    <p class="lede">The link may be old, or the post may have moved.</p>
    <p><a class="btn btn-primary" href="/">Go home</a> <a class="btn btn-outline" href="/blog">All writing</a></p>
  </div>
</Base>
<style>
  .nf { display: grid; gap: var(--space-4); padding-top: var(--space-24); max-width: calc(var(--measure) + 2 * var(--gutter)); }
  .nf p:last-child { display: flex; gap: var(--space-3); margin-top: var(--space-4); }
</style>
